.obsidian/workspace-mobile.json
.obsidian/cache
.trash/

# Operating system clutter
.DS_Store
Thumbs.db
desktop.ini

# Secrets: never commit passwords, tokens or keys
.env
.env.*
!.env.example
*.key
*.pem

# Temporary files
*.tmp
*.swp
