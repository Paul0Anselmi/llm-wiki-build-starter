#!/bin/sh
# Optional pre-commit hook for this LLM Wiki vault.
# Install it with: sh scripts/install_hooks.sh   (or: git config core.hooksPath .githooks)
# Skip it once with: git commit --no-verify

cd "$(git rev-parse --show-toplevel)" || exit 1

# Find a working Python 3: python3 on macOS/Linux, python or py on Windows.
PYTHON=""
for candidate in python3 python "py -3"; do
  if $candidate -c "import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)" >/dev/null 2>&1; then
    PYTHON="$candidate"
    break
  fi
done
if [ -z "$PYTHON" ]; then
  echo "pre-commit: Python 3.8+ not found, so the wiki checks did not run."
  echo "Install Python from https://www.python.org, or commit with --no-verify to skip."
  exit 1
fi

$PYTHON scripts/wiki_tool.py build || exit 1

# build may have rewritten the generated files; make sure they are part of this commit.
GENERATED="Wiki/catalog.jsonl Wiki/index.md Wiki/Topics/index.md Wiki/Concepts/index.md Wiki/Entities/index.md Wiki/Projects/index.md Wiki/Logs/index.md"
if ! git diff --quiet -- $GENERATED || [ -n "$(git ls-files --others --exclude-standard -- $GENERATED)" ]; then
  echo "pre-commit: the catalog and indexes changed. Add them and commit again:"
  echo "  git add Wiki/catalog.jsonl Wiki/index.md Wiki/*/index.md"
  exit 1
fi

$PYTHON scripts/wiki_tool.py lint || exit 1
$PYTHON scripts/wiki_tool.py source-lint || exit 1
$PYTHON scripts/audit_public.py || exit 1
